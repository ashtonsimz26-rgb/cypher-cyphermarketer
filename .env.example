# cyphermarketer credentials — real values live in .env (chmod 600, never committed).
# X @appCYPHERR, OAuth 1.0a user context (read+write).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Telegram SIBLING bot — MUST be its own token, never CPA's.
# getUpdates is destructive per-token: a second poller on CPA's token would
# permanently consume CPA's approval decisions. See strategy doc Q3.
CYPHERMARKETER_TELEGRAM_BOT_TOKEN=
CYPHERMARKETER_TELEGRAM_CHAT_ID=
