# Credentials — NEVER commit. Loaded by path at runtime, never echoed.
.env
.env.*
!.env.example

# Runtime
__pycache__/
*.pyc
.venv/
logs/

# Generated card renders — reproducible from the catalog + CPA renderer.
# Provenance is kept in ledger/ (image name recorded per proposal).
content/*.png
logs/
state/_*.sql

# Machine-local runtime state (telegram offset, scratch SQL) — never commit.
state/

# Hard Gate backups — timestamped pre-edit snapshots. Local safety net,
# never source of truth, never committed.
_backups/

# Build output: regenerated by graph.py from the ledger. Tracking it makes
# every diff unreadable; nothing reads it as an input.
ledger/graph.jsonl
