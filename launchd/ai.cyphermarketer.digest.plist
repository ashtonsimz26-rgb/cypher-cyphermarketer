<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>ai.cyphermarketer.digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.12</string>
        <string>/Users/ashtonsimz/Documents/openclaw/cyphermarketer/daily_digest.py --max 1 --source digest</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/ashtonsimz/Documents/openclaw/cyphermarketer</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd's PATH is minimal; the supabase CLI lives in homebrew -->
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key><string>/Users/ashtonsimz/Documents/openclaw/cyphermarketer/logs/ai.cyphermarketer.digest.out.log</string>
    <key>StandardErrorPath</key><string>/Users/ashtonsimz/Documents/openclaw/cyphermarketer/logs/ai.cyphermarketer.digest.err.log</string>
    <key>RunAtLoad</key><false/>
    <key>StartCalendarInterval</key><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
</dict>
</plist>
